# Copie este arquivo para /home/ricelli/.vps-database-backups.env na VPS.
# Os valores abaixo usam credenciais fake/exemplo. Troque na VPS pelos dados reais.
# Nao commite o arquivo real com senhas.

BACKUP_RETENTION_COUNT=7
BACKUP_DATE_FORMAT=%F

# Usuario/senha padrao do MySQL nativo no host. Pode ser um usuario dedicado
# apenas para backup com SELECT, SHOW VIEW, TRIGGER, EVENT e LOCK TABLES.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=gurupi

# Remote ja configurado no rclone. Ex.: gdrive
RCLONE_REMOTE=gdrive

# Lista de projetos que o script deve processar.
PROJECTS=(isabelle agilgestao)

ISABELLE_DB_NAME=isabelle_db
ISABELLE_BACKUP_DIR=/var/backups/isabelle/database
ISABELLE_DRIVE_FOLDER=Backups_VPS_ISABELLE
ISABELLE_DB_USER=isabelle_user
ISABELLE_DB_PASSWORD=gurupi

AGILGESTAO_DB_NAME=agilgestao_db
AGILGESTAO_BACKUP_DIR=/var/backups/agilgestao/database
AGILGESTAO_DRIVE_FOLDER=Backups_VPS_AGILGESTAO
AGILGESTAO_DB_USER=agilgestao_user
AGILGESTAO_DB_PASSWORD=gurupi
